#!/bin/bash
set -euxo pipefail

# --- install runtime ---------------------------------------------------------
dnf install -y python3-pip unzip

# --- unpack the app (embedded as a base64 zip in this user-data) --------------
mkdir -p /opt/kafka-demo
base64 -d > /tmp/kafka-demo-app.zip <<'APPZIP'
${app_zip_b64}
APPZIP
unzip -o /tmp/kafka-demo-app.zip -d /opt/kafka-demo

python3 -m pip install --upgrade pip
python3 -m pip install -r /opt/kafka-demo/requirements.txt

# --- runtime configuration ---------------------------------------------------
mkdir -p /etc/kafka-demo /var/lib/kafka-demo
cat > /etc/kafka-demo/config.env <<CONFIG
AWS_REGION=${region}
BROKERS=${brokers}
PRODUCER_TOPIC=${producer_topic}
TOPIC_PARAM=${topic_param}
CONSUMER_GROUP=${consumer_group}
STATUS_FILE=${status_file}
CONFIG

# --- install + start the three services --------------------------------------
cp /opt/kafka-demo/units/*.service /etc/systemd/system/
systemctl daemon-reload
systemctl enable --now kafka-demo-producer kafka-demo-consumer kafka-demo-dashboard
