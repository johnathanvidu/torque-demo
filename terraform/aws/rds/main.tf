data "aws_vpc" "this" {
  id = var.vpc_id
}

locals {
  engine_defaults = {
    postgres = { version = "16", port = 5432 }
    mysql    = { version = "8.0", port = 3306 }
  }

  engine_version      = coalesce(var.engine_version, local.engine_defaults[var.engine].version)
  port                = local.engine_defaults[var.engine].port
  allowed_cidr_blocks = length(var.allowed_cidr_blocks) > 0 ? var.allowed_cidr_blocks : [data.aws_vpc.this.cidr_block]
}

resource "aws_security_group" "db" {
  name        = "${var.name}-db"
  description = "Database access for ${var.name}"
  vpc_id      = var.vpc_id

  ingress {
    description = "Database port from allowed CIDRs"
    from_port   = local.port
    to_port     = local.port
    protocol    = "tcp"
    cidr_blocks = local.allowed_cidr_blocks
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

module "db" {
  source  = "terraform-aws-modules/rds/aws"
  version = "7.2.2"

  identifier = var.name

  engine            = var.engine
  engine_version    = local.engine_version
  instance_class    = var.instance_class
  allocated_storage = var.allocated_storage
  storage_encrypted = true

  db_name  = var.db_name
  username = var.username
  port     = local.port

  # Password is generated by RDS and kept in Secrets Manager; never passes through Terraform state as plain text.
  manage_master_user_password = true

  multi_az               = var.multi_az
  create_db_subnet_group = true
  db_subnet_group_name   = var.name
  subnet_ids             = var.subnet_ids
  vpc_security_group_ids = [aws_security_group.db.id]

  # Engine defaults are fine for a demo; skip custom parameter/option groups.
  create_db_parameter_group = false
  create_db_option_group    = false

  # Ephemeral environments must destroy cleanly.
  deletion_protection = false
  skip_final_snapshot = true
}
